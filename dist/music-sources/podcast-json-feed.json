{
  "sourceUrl": "https://podcast.example.org",
  "sourceName": "Example Podcast — JSON Feed",
  "version": "1.0.0",
  "author": "BBeBee",
  "sourceType": "podcast",
  "sourceGroup": "podcast",
  "sourceComment": "A podcast published as JSON Feed 1.1 (jsonfeed.org). RSS feeds need the XML engine, which this build does not have — see the README.",
  "exploreUrl": "{{source.url}}/feed.json",
  "ruleExplore": {
    "trackList": "$.items[*]",
    "trackId": "$.id",
    "title": "$.title",
    "artist": "$.author.name",
    "artwork": "$.image",
    "durationMs": "$.attachments[0].duration_in_seconds##$##000",
    "streamUrl": "$.attachments[0].url",
    "kind": "=track"
  },
  "ruleStream": {
    "url": "={{track.streamUrl}}",
    "seekable": "=true"
  },
  "allowedHosts": [
    "cdn.example.org"
  ]
}
